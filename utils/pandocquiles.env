# Paleta de Colores / Tema (Opciones: blue, cdmx, emerald, purple, amber, slate)
COLOR_THEME="blue"

# Textos y Encabezados Institucionales del PDF
PDF_SUBTITLE="Plataforma de Inteligencia Fiscal y Pre-Declarador SAT"
PDF_TOP_HEADER="tribuTACOS · Shellaquiles Org"
PDF_ORG_NAME="SHELLAQUILES.ORG"

# Metadatos del PDF (exiftool)
PDF_AUTHOR="Shellaquiles Org"
PDF_CREATOR="tribuTACOS by shellaquiles.org"
PDF_PRODUCER="Pandocquiles by shellaquiles.org"

# Configuración de Rutas y Salidas
OUTPUT_DIR="documentacion"
CSS_PDF_THEME="config/css/theme-pdf.css"
CSS_GDOCS_THEME="config/css/theme-gdocs.css"
