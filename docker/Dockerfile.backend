FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libxml2 libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .
COPY VERSION ./VERSION

ENV PYTHONPATH=/app
ENV ENVIRONMENT=production
ENV DATA_DIR=/data
ENV CFDI_EMITIDOS_DIR=/data/cfdi_emitidos
ENV CFDI_RECIBIDOS_DIR=/data/cfdi_recibidos
ENV DESCARGADOS_DIR=/data/descargados
ENV DATABASE_URL=sqlite:////data/tributacos.db

COPY docker/entrypoint-backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8010
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
