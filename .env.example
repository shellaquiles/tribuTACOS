# ==============================================================================
# tribuTACOS — VARIABLES DE ENTORNO
# ==============================================================================

# Entorno: development | production | testing
ENVIRONMENT=development

# Servidor Backend (FastAPI)
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=*

# Base de datos (SQLite por defecto, compatible con PostgreSQL)
DATABASE_URL=sqlite:///./backend/tributacos.db

# Directorios de almacenamiento de datos fiscales
DATA_DIR=./backend/data
CFDI_EMITIDOS_DIR=./cfdi_emitidos
CFDI_RECIBIDOS_DIR=./cfdi_recibidos
DESCARGADOS_DIR=./descargados

# Contribuyente y Configuración Fiscal por defecto (Demo)
DEFAULT_CLIENT_RFC=SHLL250825XYZ
DEFAULT_CLIENT_NAME=Sheila Shellaquiles Ortega
DEFAULT_CLIENT_EMAIL=tributacos@shellaquiles.org

# Seguridad / Autenticación (Opcional)
AUTH_ENABLED=false
SECRET_KEY=tributacos-secret-key-super-secure-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

