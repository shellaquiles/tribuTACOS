# ==============================================================================
# DECLARA PRO / TRIBUTACOS - VARIABLES DE ENTORNO
# ==============================================================================

# Entorno: development | production | testing
ENVIRONMENT=development

# Servidor Backend
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=*

# Base de datos (SQLite por defecto, compatible con PostgreSQL)
DATABASE_URL=sqlite:///./tributacos.db

# Directorios de almacenamiento de datos fiscales
DATA_DIR=./data
CFDI_EMITIDOS_DIR=../cfdi_emitidos
CFDI_RECIBIDOS_DIR=../cfdi_recibidos
DESCARGADOS_DIR=../descargados

# Contribuyente y Configuración Fiscal por defecto
DEFAULT_CLIENT_RFC=HECA850101XYZ
DEFAULT_CLIENT_NAME=Contribuyente Principal

# Seguridad / Autenticación (Opcional)
AUTH_ENABLED=false
SECRET_KEY=tributacos-secret-key-super-secure-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080
